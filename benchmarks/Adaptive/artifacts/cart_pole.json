  "system_name": "CartPolePendulum",
  "dynamics": {
    "states": [
      "cart_pos",
      "cart_vel",
      "pole_angle",
      "pole_ang_vel"
    ],
    "state_meanings": [
      "cart position (m)",
      "cart velocity (m/s)",
      "pole angle from upright (rad)",
      "pole angular velocity (rad/s)"
    ],
    "inputs": [
      "force"
    ],
    "outputs": [
      "pole_angle"
    ],
    "state_equations": [
      "cart_vel",
      "(force + m * sin(pole_angle) * (l * pole_ang_vel**2 + g * cos(pole_angle)) - b * cart_vel) / (M + m * sin(pole_angle)**2)",
      "pole_ang_vel",
      "(-force * cos(pole_angle) - m * l * pole_ang_vel**2 * cos(pole_angle) * sin(pole_angle) - (M + m) * g * sin(pole_angle)) / (l * (M + m * sin(pole_angle)**2))"
    ],
    "x0": [
      0.0,
      0.0,
      0.2,
      0.0
    ],
    "references": [
      {
        "output": "pole_angle",
        "expr": "0"
      }
    ],
    "parameters": {
      "M": 1.0,
      "m": 0.1,
      "l": 0.5,
      "g": 9.81,
      "b": 0.05
    },
    "uncertainty": [],
    "disturbance": [],
    "system_type": "SISO",
    "sim_time": 10.0,
    "solver_step": 0.001,
    "assumptions": [
