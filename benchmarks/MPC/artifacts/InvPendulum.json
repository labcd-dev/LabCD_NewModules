  "system_name": "InvertedPendulumDynamics",
  "python_code": "import numpy as np\n\ndef dynamics(t, x, u):\n    theta = float(x[0])\n    theta_dot = float(x[1])\n    torque = float(u[0])\n\n    mass = 0.1\n    length = 0.5\n    damping = 0.1\n    gravity = 9.81\n\n    theta_ddot = (\n        torque\n        - mass * gravity * length * np.sin(theta)\n        - damping * theta_dot\n    ) / (mass * length ** 2)\n\n    return np.array([\n        theta_dot,\n        theta_ddot\n    ], dtype=float)\n",
